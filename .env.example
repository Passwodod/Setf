# Copy to .env and fill in. Never commit .env.
SIA_DOMAIN=sia.example.com
POSTGRES_USER=sia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sia
REDIS_PASSWORD=change-me
# generate with: openssl rand -hex 32
SIA_JWT_SECRET=
SIA_ENV=production
SIA_ALLOW_REGISTRATION=false
SIA_OPENAI_API_KEY=
SIA_TELEGRAM_BOT_TOKEN=
SIA_TELEGRAM_WEBHOOK_SECRET=
# Fernet keys for MTProto sessions; comma-separate for rotation (newest first).
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIA_SESSION_ENCRYPTION_KEYS=
